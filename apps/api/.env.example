NODE_ENV=development
PORT=3000
# Origen(es) de la web permitidos por CORS, separados por coma.
CORS_ORIGEN=http://localhost:5173
# Saltos de proxy de confianza: 1 detrás de Nginx (S0.4), para que la bitácora guarde la IP real.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
JSON_LIMITE=100kb
# Firma del access JWT (S1.3): obligatorio, 32 caracteres o más. Valor solo de desarrollo;
# en un servidor se genera con `openssl rand -base64 48` y nunca se commitea.
JWT_SECRET=desarrollo-solo-local-cambiar-en-servidores-0000
# Opcional: intentos de login por minuto por IP (RNF-10). Por defecto 10; solo se cambia si la
# escuela entera sale por una misma IP y el límite molesta (S1.4).
# LOGIN_LIMITE_POR_MINUTO=10

# Base de datos local (docker compose up -d db). Valores de desarrollo, nunca reales.
# Si cambiás DB_PORT en el .env de la raíz, cambiá también el puerto acá.
DATABASE_URL=postgresql://siset:siset_dev@localhost:5432/siset
# En Docker la API se conecta como siset_app (sin UPDATE/DELETE en la bitácora, S6.4). En desarrollo
# local podés seguir con el dueño (siset) o usar:
# DATABASE_URL=postgresql://siset_app:siset_app_desarrollo_local@localhost:5432/siset
# Solo para `npm run bd:rol-app` (activa siset_app con esta contraseña):
APP_DB_PASSWORD=siset_app_desarrollo_local
# Servidor para los tests de BD: cada corrida crea y elimina su propia base
# siset_test_<id> (el nombre de la URL solo se usa como referencia).
DATABASE_URL_TEST=postgresql://siset:siset_dev@localhost:5432/siset_test

# Kardex inicial que crea el seed. Mínimo 8 caracteres, con letras, números y símbolos (DEC-011).
SEED_KARDEX_CI=1000001
SEED_KARDEX_PASSWORD=cambiar-123
SEED_KARDEX_COMPLEMENTO=
SEED_KARDEX_NOMBRES=Kardex
SEED_KARDEX_APELLIDO_PATERNO=Inicial
SEED_KARDEX_APELLIDO_MATERNO=
# Código de sede del Kardex: ANCOCAGUA (D-15, provisional) o LA_PAZ.
SEED_KARDEX_SEDE=ANCOCAGUA

# Administrador inicial (DEC-054): crea usuarios, asigna roles y mira la bitácora. Opcional: sin SEED_ADMIN_CI el
# seed no lo crea. Mismas reglas y mismos campos opcionales que el Kardex (SEED_ADMIN_NOMBRES, _SEDE…).
# Si es la misma persona que el Kardex (mismo CI), el seed le crea una segunda cuenta, <CI>-ADM (DEC-063).
SEED_ADMIN_CI=1000002
SEED_ADMIN_PASSWORD=cambiar-456
