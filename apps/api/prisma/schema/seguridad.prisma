// Módulo dueño: seguridad (ADR-0001). Modelo v1: docs/product/modelo-datos.md.

model Rol {
  id          Int       @id @default(autoincrement())
  /// ESTUDIANTE, EGRESADO, SEC_DIR, SEC_COORD, COORDINADOR, KARDEX
  codigo      String    @unique @db.VarChar(20)
  /// Nombre corto del prototipo.
  nombre      String    @db.VarChar(80)
  /// Nombre institucional largo.
  descripcion String?   @db.VarChar(255)
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  id                    Int                  @id @default(autoincrement())
  personaId             Int                  @unique @map("persona_id")
  rolId                 Int                  @map("rol_id")
  /// Sede del personal; NULL para estudiante y egresado (D-24).
  sedeId                Int?                 @map("sede_id")
  /// CI o CI-complemento (D-14, D-25).
  username              String               @unique @db.VarChar(40)
  passwordHash          String               @map("password_hash") @db.VarChar(100)
  activo                Boolean              @default(true)
  intentosFallidos      Int                  @default(0) @map("intentos_fallidos") @db.SmallInt
  bloqueadoHasta        DateTime?            @map("bloqueado_hasta") @db.Timestamptz(6)
  debeCambiarPassword   Boolean              @default(true) @map("debe_cambiar_password")
  ultimoAcceso          DateTime?            @map("ultimo_acceso") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  persona               Persona              @relation(fields: [personaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rol                   Rol                  @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sede                  Sede?                @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  registrosAuditoria    LogAuditoria[]
  refreshTokens         RefreshToken[]
  /// back-relation (ADR-0001: no usar desde otro módulo)
  requisitosRegistrados RequisitoFile[]
  /// back-relations (ADR-0001: no usar desde otro módulo)
  bloqueosHechos        BloqueoFile[]        @relation("BloqueoPor")
  desbloqueosHechos     BloqueoFile[]        @relation("DesbloqueoPor")
  /// back-relation (ADR-0001: no usar desde otro módulo)
  movimientosHojaRuta   MovimientoHojaRuta[]

  @@index([rolId])
  @@index([sedeId])
  @@map("usuario")
}

/// Sesiones activas: refresh token rotativo (SDD S1.1 §2.1).
model RefreshToken {
  id               Int            @id @default(autoincrement())
  usuarioId        Int            @map("usuario_id")
  /// SHA-256 en hexadecimal del token; el token en claro nunca se guarda (RNF-01).
  tokenHash        String         @unique @map("token_hash") @db.Char(64)
  expiraEn         DateTime       @map("expira_en") @db.Timestamptz(6)
  revocadoEn       DateTime?      @map("revocado_en") @db.Timestamptz(6)
  ip               String?        @db.Inet
  userAgent        String?        @map("user_agent") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// El token que lo reemplazó al rotar. No nulo ⇔ se revocó por rotación (SDD S1.15 §2.1, DEC-026).
  reemplazadoPorId Int?           @map("reemplazado_por_id")
  /// CASCADE: excepción documentada en modelo-datos.md §Convenciones (DEC-006).
  usuario          Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  reemplazadoPor   RefreshToken?  @relation("ReemplazoRefresh", fields: [reemplazadoPorId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reemplaza        RefreshToken[] @relation("ReemplazoRefresh")

  @@index([usuarioId])
  @@map("refresh_token")
}
