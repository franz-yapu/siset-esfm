// Módulo dueño: auditoria (ADR-0001). Solo inserción por triggers (ADR-0003);
// la app (siset_app) no tiene UPDATE/DELETE/TRUNCATE sobre esta tabla (S6.4). Modelo v1: docs/product/modelo-datos.md.

model LogAuditoria {
  id           Int      @id @default(autoincrement())
  /// Nullable: eventos sin usuario (DEC-006 #5; no cierra D-26).
  usuarioId    Int?     @map("usuario_id")
  accion       String   @db.VarChar(40)
  modulo       String   @db.VarChar(40)
  entidad      String?  @db.VarChar(40)
  /// Texto: apunta a entidades de cualquier módulo.
  entidadId    String?  @map("entidad_id") @db.VarChar(40)
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  fecha        DateTime @default(now()) @db.Timestamptz(6)
  usuario      Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fecha(sort: Desc)])
  @@index([usuarioId, fecha(sort: Desc)])
  @@index([modulo, fecha(sort: Desc)])
  /// Historial de un registro: "quién editó este file" (DEC-007 #4, S6.4).
  @@index([entidad, entidadId, fecha(sort: Desc)])
  @@map("log_auditoria")
}
