// Módulo dueño: catalogos (ADR-0001). Modelo v1: docs/product/modelo-datos.md.

model Sede {
  id        Int       @id @default(autoincrement())
  /// LA_PAZ, ANCOCAGUA
  codigo    String    @unique @db.VarChar(20)
  nombre    String    @db.VarChar(100)
  direccion String?   @db.VarChar(200)
  activo    Boolean   @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  usuarios  Usuario[]

  @@map("sede")
}

model Especialidad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(120)
  activo Boolean @default(true)

  @@map("especialidad")
}
