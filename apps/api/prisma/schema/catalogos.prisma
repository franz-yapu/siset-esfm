// Módulo dueño: catalogos (ADR-0001). Modelo v1: docs/product/modelo-datos.md.

model Sede {
  id                  Int                  @id @default(autoincrement())
  /// LA_PAZ, ANCOCAGUA
  codigo              String               @unique @db.VarChar(20)
  nombre              String               @db.VarChar(100)
  direccion           String?              @db.VarChar(200)
  activo              Boolean              @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  usuarios            Usuario[]
  /// back-relation (ADR-0001: no usar desde otro módulo)
  hojasRutaActuales   HojaRuta[]           @relation("SedeActualHojaRuta")
  /// back-relation (ADR-0001: no usar desde otro módulo)
  movimientosHojaRuta MovimientoHojaRuta[]

  @@map("sede")
}

model Especialidad {
  id     Int             @id @default(autoincrement())
  nombre String          @unique @db.VarChar(120)
  activo Boolean         @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  files  FileAcademico[]

  @@map("especialidad")
}

/// Reglas configurables sin tocar código (modelo-datos.md §catalogos, SDD S1.1 §2.1).
model Parametro {
  clave       String   @id @db.VarChar(50)
  valor       String   @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("parametro")
}

/// Catálogo de requisitos del file, una fila por requisito concreto con su año y nivel
/// (D-04, D-18; SDD S2.1 v1.1). Provisional hasta la lista completa de la escuela.
model RequisitoTipo {
  id             Int             @id @default(autoincrement())
  /// TACFI_1, TCLO_BASICO, CERT_NOTAS…
  codigo         String          @unique @db.VarChar(30)
  nombre         String          @db.VarChar(120)
  descripcion    String?         @db.VarChar(255)
  /// Año de formación al que corresponde (1–5); null si no es de un año.
  anioFormacion  Int?            @map("anio_formacion") @db.SmallInt
  /// Nivel del TCLO; null para los demás.
  nivel          NivelTclo?
  /// Cuenta para el semáforo del file.
  obligatorio    Boolean         @default(true)
  /// N.º en la hoja "Documentación existente en folder personal" (DEC-051): el orden en pantalla.
  orden          Int             @default(0) @db.SmallInt
  /// Se entrega una vez por gestión (matrícula, certificado de notas).
  porGestion     Boolean         @default(false) @map("por_gestion")
  /// Pide el nombre del curso y la entidad emisora (TACFI).
  pideCurso      Boolean         @default(false) @map("pide_curso")
  /// Solo para un género (libreta militar: MASCULINO).
  soloGenero     Genero?         @map("solo_genero")
  /// Solo para una modalidad de ingreso; una letra vale para todas las que empiezan con ella (ADR-0007).
  soloModalidad  String?         @map("solo_modalidad") @db.VarChar(5)
  activo         Boolean         @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  requisitosFile RequisitoFile[]

  @@map("requisito_tipo")
}

/// Tipos de trámite (D-21, DEC-033): los 4 que llegan a Ancocagua. Se siembran en la migración de S3.1.
model TipoTramite {
  id               Int        @id @default(autoincrement())
  codigo           String     @unique @db.VarChar(40)
  nombre           String     @db.VarChar(120)
  /// Con valorado: historial y legalización (D-05). Define el flujo de la hoja de ruta.
  requiereValorado Boolean    @map("requiere_valorado")
  activo           Boolean    @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  hojasRuta        HojaRuta[]

  @@map("tipo_tramite")
}
