// Módulo dueño: catalogos (ADR-0001). Modelo v1: docs/product/modelo-datos.md.

model Sede {
  id        Int       @id @default(autoincrement())
  /// LA_PAZ, ANCOCAGUA
  codigo    String    @unique @db.VarChar(20)
  nombre    String    @db.VarChar(100)
  direccion String?   @db.VarChar(200)
  activo    Boolean   @default(true)
  /// back-relation (ADR-0001: no usar desde otro módulo)
  usuarios  Usuario[]

  @@map("sede")
}

model Especialidad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(120)
  activo Boolean @default(true)

  @@map("especialidad")
}

/// Reglas configurables sin tocar código (modelo-datos.md §catalogos, SDD S1.1 §2.1).
model Parametro {
  clave       String   @id @db.VarChar(50)
  valor       String   @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("parametro")
}
