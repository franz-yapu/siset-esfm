{
  "name": "@siset/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsdown",
    "start": "node dist/servidor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "bd:generar": "prisma generate",
    "bd:migrar": "prisma migrate dev",
    "bd:desplegar": "prisma migrate deploy",
    "bd:seed": "prisma db seed",
    "test:bd": "vitest run --config vitest.bd.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
