# Variables de docker compose (raíz del repo). Valores de desarrollo: nunca reales en el repo.
DB_PORT=5432
POSTGRES_PASSWORD=siset_dev

# Stack completo (docker compose --profile completo ...)
WEB_PORT=8080
WEB_ORIGEN=http://localhost:8080
# Firma del access JWT de la API (S1.3): obligatorio, 32 caracteres o más. En un servidor: openssl rand -base64 48
JWT_SECRET=desarrollo-solo-local-cambiar-en-servidores-0000
# Build de la web: false (todo mock) | true | lista de servicios (auth,files). Ver SDD S0.8.
VITE_USAR_API=false
VITE_DEMO=true
