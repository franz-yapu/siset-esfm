{
  "name": "siset",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev -w @siset/web\" \"npm:dev -w @siset/api\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  }
}
